# The operator facts, machine-readable and committed. The thin CLAUDE.md
# imports this file, so the model reads the same lines lib/shepherd-common.sh
# sources. `/shepherd:init` writes it; edit it by hand when a fact changes.
#
# Machine-specific values may be overridden in a gitignored .shepherd/local.env
# beside this file — that is how one instance repository runs on a second
# machine with a different code directory.

# The marker every instance command and the SessionStart hook gate on. Its
# presence is what makes this directory a shepherd instance.
SHEPHERD_INSTANCE=1

SHEPHERD_OPERATOR=CHANGE-ME
SHEPHERD_CODE_DIR=CHANGE-ME

# sounds | silent — whether completions and escalations carry a herdr sound
SHEPHERD_NOTIFICATIONS=sounds

# Total concurrent workers across ALL instances on this machine, not per instance
SHEPHERD_WORKER_CAP=6

# Every shepherd id this instance repository serves, space separated
SHEPHERD_IDS="shepherd-1"

# Wake step 1 refuses to run on a plugin older than this
SHEPHERD_MIN_PLUGIN=1.0.0
