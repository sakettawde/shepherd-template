#!/usr/bin/env bash
# Shepherd's coordination lock. See docs/specs/2026-08-18-multi-shepherd-design.md S6
# and docs/specs/2026-09-02-coordination-hardening-design.md.
#
#   shepherd-lock acquire  <name> <holder> <pane> <session> [task]
#   shepherd-lock takeover <name> <holder> <pane> <session> [task]
#   shepherd-lock release  <name> <holder> [<pane> <session>]   # re-reads before rm; CHANGED = left alone
#   shepherd-lock check    <name>
#   shepherd-lock live     <shepherd-id>     # prints live|gone|unresolved <id> <pane> <session>; exit 0|1|2
#   shepherd-lock sweep    [--dry-run]       # exit 3 when a line needs a human: MALFORMED, SWEEP-SKIPPED,
#                                      #   UNKNOWN-LOCK, UNKNOWN-LIVENESS, RM-FAILED; 0 when all routine
#   shepherd-lock stats                      # <count> <verb> <verdict> from the events log
#
# A lock file holds exactly one line:
#   <holder> <pane> <session> <task|none> <acquired-iso8601>
# Names must match ^[A-Za-z0-9_][A-Za-z0-9_.~-]*$ - a bad name is exit 2 before any file is touched.
#
# Every verdict that touches a lock is appended to ledger/events.log (gitignored,
# machine-local), one line each:
#   <iso8601> <instance> <verb> <target> <verdict> [detail...]
# The paths that reach no lock write nothing: a rejected name, and a field that would
# not read back, are both refused with exit 2 before any file is opened; `check` is
# read-only.
# Verdict is the first word the command printed. Count them without this script -
# the leading grep is the only "since" filter there is, and dropping it counts the
# whole log (spec S7):
#   grep "^$(date +%Y-%m)" ledger/events.log | awk '{c[$3" "$5]++} END{for(k in c) print c[k], k}' | sort -k2
set -uo pipefail
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../lib/shepherd-common.sh"
LONG_HOLD_SECONDS=600

usage() { sed -n '2,/^set -uo pipefail/{/^set -uo pipefail/!p}' "$0" >&2; exit 2; }
lock_path() { printf '%s/%s.lock' "$LOCKS_DIR" "$1"; }

# validate_fields <holder> <pane> <session> <task>
# Every field of a lock line must be one whitespace-free token, or the line
# cannot be read back: `read -r holder pane session task ts` silently shifts
# every later field left. An empty holder - which is exactly what an unset
# $SHEPHERD_ID produces, and CLAUDE.md S0 documents unset as a real default -
# would write a line whose "task" field holds the timestamp: a lock its owner
# can never release, and one sweep frees out from under a running worker
# because task_state finds no such card. Refuse to write it at all.
validate_fields() {
  local names=(holder pane session task) vals=("$1" "$2" "$3" "$4") i
  for i in 0 1 2 3; do
    case ${vals[$i]} in
      ''|*[[:space:]]*)
        echo "ERROR: ${names[$i]} must be non-empty and free of whitespace (got '${vals[$i]}')" >&2
        return 2 ;;
    esac
  done
  return 0
}

cmd_acquire() {
  local name=$1 holder=$2 pane=$3 session=$4 task=${5:-none} f held
  valid_name name "$name" || return 2
  validate_fields "$holder" "$pane" "$session" "$task" || return 2
  f=$(lock_path "$name")
  atomic_create "$f" "$holder $pane $session $task $(now_iso)"
  case $? in
    0) elog "$holder" acquire "$name" ACQUIRED "$task"; echo "ACQUIRED $name"; return 0 ;;
    1) held=$(lock_line "$f"); elog "$holder" acquire "$name" HELD "$held"; echo "HELD $name $held"; return 1 ;;
    *) elog "$holder" acquire "$name" ERROR "could not write"; echo "ERROR could not write $f" >&2; return 2 ;;
  esac
}

# S10 step 3 / CLAUDE.md S8 step 6: the one sanctioned way to claim a lock
# whose holder is gone. `acquire` returns HELD, `release` returns REFUSED and
# `sweep` deliberately keeps a project lock over an active task (the orphan
# rule), so without this the most common recovery - a shepherd that crashed
# with an active task and restarted under the same id - has no runnable
# command for the step that tells it to take the lock back.
#
# Gated on liveness, never on age, and never on a read from an earlier step.
cmd_takeover() {
  local name=$1 holder=$2 pane=$3 session=$4 task=${5:-none}
  local f line h_holder h_pane h_session live_rc dir tmp
  valid_name name "$name" || return 2
  validate_fields "$holder" "$pane" "$session" "$task" || return 2
  f=$(lock_path "$name")

  # Nothing to take over: this is a plain acquire, atomic against a racer
  # that creates the lock between these two lines.
  if [ ! -f "$f" ]; then
    cmd_acquire "$@"
    return $?
  fi

  line=$(lock_line "$f")
  h_holder= h_pane= h_session=
  [ -n "$line" ] && read -r h_holder h_pane h_session _ <<<"$line"
  if [ -z "$h_pane" ] || [ -z "$h_session" ]; then
    elog "$holder" takeover "$name" MALFORMED "left in place"
    echo "MALFORMED $name - left in place, inspect by hand" >&2
    return 1
  fi

  shepherd_live "$h_pane" "$h_session" "$h_holder"
  live_rc=$?
  if [ "$live_rc" -eq 0 ]; then
    elog "$holder" takeover "$name" REFUSED "held by live $h_holder pane $h_pane"
    echo "REFUSED $name is held by a live instance ($h_holder, pane $h_pane) - never steal from a live holder" >&2
    return 1
  fi
  # Only an explicit 1 (gone) authorises a takeover - the same
  # polarity sweep uses. "Unresolved" is not evidence that the holder is gone.
  if [ "$live_rc" -ne 1 ]; then
    elog "$holder" takeover "$name" UNKNOWN-LIVENESS "$h_holder pane $h_pane"
    echo "UNKNOWN-LIVENESS $name $h_holder - cannot reach herdr for pane $h_pane, left in place" >&2
    return 1
  fi

  # The liveness probe was a herdr round-trip. Another instance may have
  # taken this same lock over while we waited; the timestamp field makes
  # each acquisition's line unique, so re-reading it here is a sound
  # compare-before-write - the same guard cmd_sweep uses before it unlinks.
  if [ "$(lock_line "$f")" != "$line" ]; then
    elog "$holder" takeover "$name" CHANGED "re-acquired during the probe"
    echo "CHANGED $name - re-acquired during the liveness probe, left alone" >&2
    return 1
  fi

  dir=$(dirname "$f")
  tmp=$(mktemp "$dir/.tmp.XXXXXX") || { elog "$holder" takeover "$name" ERROR "could not write"; echo "ERROR could not write $f" >&2; return 2; }
  if ! printf '%s\n' "$holder $pane $session $task $(now_iso)" > "$tmp"; then
    rm -f "$tmp"; elog "$holder" takeover "$name" ERROR "could not write"; echo "ERROR could not write $f" >&2; return 2
  fi
  # Atomic rename, never an in-place rewrite (spec S10 step 3): a rewrite
  # across two operations lets a sweeper observe a truncated or absent lock,
  # classify it "names no task", delete it, and admit a third instance.
  if ! mv -f "$tmp" "$f"; then
    rm -f "$tmp"; elog "$holder" takeover "$name" ERROR "could not rename"; echo "ERROR could not rename over $f" >&2; return 2
  fi
  elog "$holder" takeover "$name" TOOK-OVER "from $h_holder $task"
  echo "TOOK-OVER $name (from $h_holder, holder gone)"
  return 0
}

# release <name> <holder> [<pane> <session>]
# Compare-before-delete: the line is captured on the first read and re-read
# immediately before rm. A changed line belongs to a fresh acquisition (the
# timestamp field makes every line unique) and is left alone, reported
# CHANGED. Holder-only is the default: a rolled-over instance legitimately
# releases a lock its previous session acquired - the holder id is the
# identity, the session is not. With pane and session given, both must match -
# gated on ARITY, not on content: `release <name> <holder> "" ""` satisfies the
# dispatcher's four-argument form, and a content gate ([ -n "$pane$session" ])
# skipped the comparison for it, deleting the lock the pair was passed to guard.
cmd_release() {
  local name=$1 holder=$2 pane=${3:-} session=${4:-} f line cur c_pane c_session
  valid_name name "$name" || return 2
  f=$(lock_path "$name")
  line=$(lock_line "$f")
  cur= c_pane= c_session=
  [ -n "$line" ] && read -r cur c_pane c_session _ <<<"$line"
  if [ -z "$cur" ]; then elog "$holder" release "$name" FREE; echo "FREE $name"; return 0; fi
  if [ "$cur" != "$holder" ]; then
    elog "$holder" release "$name" REFUSED "held by $cur"
    echo "REFUSED $name is held by $cur, not $holder" >&2
    return 1
  fi
  if [ $# -eq 4 ] && { [ "$c_pane" != "$pane" ] || [ "$c_session" != "$session" ]; }; then
    elog "$holder" release "$name" REFUSED "held from $c_pane $c_session not $pane $session"
    echo "REFUSED $name is held by $holder from pane $c_pane session $c_session, not $pane $session" >&2
    return 1
  fi
  if [ "$(lock_line "$f")" != "$line" ]; then
    elog "$holder" release "$name" CHANGED "re-acquired since the check"
    echo "CHANGED $name - re-acquired since the check, left alone" >&2
    return 1
  fi
  # An unchecked rm let an unwritable locks directory produce an audit line
  # asserting a release that never happened - the one claim the log must never
  # carry, because every reader treats RELEASED as "the lock is free now".
  rm -f "$f" || { elog "$holder" release "$name" ERROR "could not remove"; echo "ERROR could not remove $f" >&2; return 2; }
  elog "$holder" release "$name" RELEASED
  echo "RELEASED $name"
}

cmd_check() {
  local name=$1 f
  valid_name name "$name" || return 2
  f=$(lock_path "$name")
  if [ ! -f "$f" ]; then echo "FREE $name"; return 1; fi
  # lock_line, not cat: a lock file holds exactly one line, and every reader of
  # this output (retro step 3, adapter R7) takes its fields positionally. A
  # second line in the file would otherwise reach them as a second HELD record.
  echo "HELD $name $(lock_line "$f")"
}

# live <shepherd-id> - prints `live|gone|unresolved <id> <pane> <session>`,
# exits 0|1|2. Reads the identity lock and resolves its pair through
# shepherd_live with the id as holder. No identity lock: gone (the instance
# never launched or was swept). Malformed identity lock: unresolved. This is
# the command the wake, retro and dispatch procedures source the library
# function by hand for today (CLAUDE.md S4a, adapter R7).
cmd_live() {
  local id=$1 f line h_holder h_pane h_session rc word me=${SHEPHERD_ID:--}
  valid_shepherd_id "$id" || return 2
  f=$(lock_path "$id")
  if [ ! -f "$f" ]; then
    elog "$me" live "$id" gone "no identity lock"
    echo "gone $id - -"
    return 1
  fi
  line=$(lock_line "$f")
  h_holder= h_pane= h_session=
  [ -n "$line" ] && read -r h_holder h_pane h_session _ <<<"$line"
  if [ -z "$h_pane" ] || [ -z "$h_session" ]; then
    elog "$me" live "$id" unresolved "malformed identity lock"
    echo "unresolved $id - -"
    return 2
  fi
  shepherd_live "$h_pane" "$h_session" "$id"
  rc=$?
  case $rc in 0) word=live ;; 1) word=gone ;; *) word=unresolved; rc=2 ;; esac
  elog "$me" live "$id" "$word" "$h_pane $h_session"
  echo "$word $id $h_pane $h_session"
  return "$rc"
}

# stats - one count per (verb, verdict) pair in the events log, so the dead
# arms of the sweep can be found. The header documents the same awk - behind
# the month-bounding grep S7 names - for use without this script.
cmd_stats() {
  if [ ! -f "$EVENTS_LOG" ]; then echo "no events yet ($EVENTS_LOG)"; return 0; fi
  awk '{c[$3" "$5]++} END{for(k in c) print c[k], k}' "$EVENTS_LOG" | sort -k2,2 -k3,3
}

# S6.4. Prints one line per lock acted on. Never steals from a live holder.
#
# Exit 3 when at least one printed line needs a human (MALFORMED,
# SWEEP-SKIPPED, UNKNOWN-LOCK, UNKNOWN-LIVENESS, RM-FAILED); 0 only when
# everything it saw was routine. `--dry-run` prints the same verdicts and
# performs no rm, no temp cleanup and no elog - a dry run that logged SWEPT
# would double-count every verdict in `stats`.
cmd_sweep() {
  local f base holder pane session task ts state age nowsec tssec line live_rc
  local dry=0 rc=0 me=${SHEPHERD_ID:--}
  case ${1:-} in
    --dry-run) dry=1 ;;
    '') ;;
    *) usage ;;
  esac
  # say <verdict> <target> <rest...>: print the line exactly as before, log it
  # (unless dry), and raise the exit code for the human-needed kinds.
  say() {
    local verdict=$1 target=$2; shift 2
    echo "$verdict $target $*"
    [ "$dry" -eq 1 ] || elog "$me" sweep "$target" "$verdict" "$*"
    case $verdict in MALFORMED|SWEEP-SKIPPED|UNKNOWN-LOCK|UNKNOWN-LIVENESS|RM-FAILED) rc=3 ;; esac
  }
  # unlink_lock <file> - 0 when the lock is gone, non-zero when rm refused.
  # A dry run takes the success path without calling rm at all. rm's own
  # stderr is discarded because the caller turns the failure into a verdict
  # line: unchecked, an unwritable locks directory printed a bare
  # `rm: cannot remove ...` with no verdict prefix and then claimed SWEPT -
  # the same false audit claim cmd_release refuses to make about its own rm.
  unlink_lock() { [ "$dry" -eq 1 ] && return 0; rm -f "$1" 2>/dev/null; }

  [ "$dry" -eq 1 ] && echo "DRY-RUN no changes will be made"
  [ -d "$LOCKS_DIR" ] || return 0

  # A liveness oracle that cannot answer must never be read as "everyone is gone".
  # Sweep is the only mass-deleting command in the system and it runs unattended
  # at session start, so one herdr outage would otherwise unlink every lock.
  # The test-hook bypass below only applies when hooks_active (SHEPHERD_TEST_HOOKS=1):
  # outside a test harness, SHEPHERD_LIVENESS_OVERRIDE/UNKNOWN merely being set
  # in the environment must never itself skip the real pane_probe check.
  if ! hooks_active || { [ -z "${SHEPHERD_LIVENESS_OVERRIDE+x}" ] && [ -z "${SHEPHERD_LIVENESS_UNKNOWN+x}" ]; }; then
    if [ -z "${HERDR_PANE_ID:-}" ] || ! pane_probe "$HERDR_PANE_ID" >/dev/null 2>&1; then
      echo "SWEEP-SKIPPED liveness oracle unavailable - no locks inspected"
      [ "$dry" -eq 1 ] || elog "$me" sweep - SWEEP-SKIPPED "liveness oracle unavailable"
      return 3
    fi
  fi

  nowsec=$(date +%s)
  for f in "$LOCKS_DIR"/*.lock; do
    [ -e "$f" ] || continue
    base=$(basename "$f" .lock)
    line=$(lock_line "$f")
    if [ -z "$line" ]; then
      say MALFORMED "$base" "- left in place, inspect by hand"
      continue
    fi
    read -r holder pane session task ts <<<"$line"
    # A line that parses but is SHORT is not a gone holder. With session
    # empty, shepherd_live compares the live pane's session id against ""
    # and returns 1 (gone) - so sweep would unlink the project lock of a
    # running instance and report it as a routine SWEPT. takeover,
    # shepherd-identity acquire/touch and reserve-task-id sweep all guard
    # this input already; sweep is the only mass-deleting command, so it
    # needs the guard most.
    if [ -z "$holder" ] || [ -z "$pane" ] || [ -z "$session" ]; then
      say MALFORMED "$base" "- left in place, inspect by hand"
      continue
    fi

    # The holder is passed so a shepherd-* instance that rolled over (new
    # session id, identity lock re-acquired) still reads live through its
    # identity lock - see shepherd_live and the hardening spec S6.
    shepherd_live "$pane" "$session" "$holder"
    live_rc=$?

    if [ "$live_rc" -eq 0 ]; then
      case $base in
        card-*|dispatch)
          tssec=""
          [ -n "$ts" ] && tssec=$(date -d "$ts" +%s 2>/dev/null)
          [ -n "$tssec" ] || tssec=$nowsec
          age=$(( nowsec - tssec ))
          if [ "$age" -gt "$LONG_HOLD_SECONDS" ]; then
            say LONG-HELD "$base" "$holder ${age}s - report to Saket, never steal"
          fi
          ;;
      esac
      continue
    fi

    # Anything other than gone (1) - unresolved (2), or any
    # return code shepherd_live's contract does not promise - must never
    # reach the delete logic below. Only an explicit 1 may free a lock.
    # Deleting on an unresolved probe would free a live holder's claim on
    # nothing more than a failed round-trip - the exact defect this gate
    # exists to close.
    if [ "$live_rc" -ne 1 ]; then
      say UNKNOWN-LIVENESS "$base" "$holder - cannot reach herdr for pane $pane, left in place"
      continue
    fi

    # live_rc == 1 (gone). The liveness probe above is a herdr
    # round-trip. Another instance may have swept this same lock and
    # re-acquired the name while we waited. Deleting on the stale read would
    # unlink a LIVE holder's lock and let a third instance into the same
    # checkout. The timestamp field makes each acquisition unique.
    if [ "$(lock_line "$f")" != "$line" ]; then
      say CHANGED "$base" "- re-acquired during the liveness probe, left alone"
      continue
    fi

    case $base in
      card-*|dispatch|shepherd-*)
        if unlink_lock "$f"; then say SWEPT "$base" "(holder $holder gone)"
        else say RM-FAILED "$base" "- could not remove, inspect by hand"; fi ;;
      project-*)
        state=""
        [ "$task" != none ] && state=$(task_state "$task")
        if is_active_state "$state"; then
          say ORPHAN "$base" "$task state=$state (holder $holder gone) - lock kept, worker still running"
        elif unlink_lock "$f"; then say SWEPT "$base" "(holder $holder gone, task $task state=${state:-none})"
        else say RM-FAILED "$base" "- could not remove, inspect by hand"; fi
        ;;
      *)
        say UNKNOWN-LOCK "$base" "(holder $holder gone) - left in place" ;;
    esac
  done
  [ "$dry" -eq 1 ] || find "$LOCKS_DIR" -maxdepth 1 -name '.tmp.*' -mmin +60 -delete 2>/dev/null
  return "$rc"
}

case ${1:-} in
  acquire)  shift; [ $# -ge 4 ] || usage; cmd_acquire  "$@" ;;
  takeover) shift; [ $# -ge 4 ] || usage; cmd_takeover "$@" ;;
  release)  shift; { [ $# -eq 2 ] || [ $# -eq 4 ]; } || usage; cmd_release "$@" ;;
  check)    shift; [ $# -ge 1 ] || usage; cmd_check    "$@" ;;
  live)     shift; [ $# -eq 1 ] || usage; cmd_live     "$@" ;;
  stats)    shift; [ $# -eq 0 ] || usage; cmd_stats ;;
  sweep)    shift; [ $# -le 1 ] || usage; cmd_sweep "${1:-}" ;;
  *) usage ;;
esac
