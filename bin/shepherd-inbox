#!/usr/bin/env bash
# Shepherd's side of the Linear agent inbox: the only place the shepherd-inbox
# Worker's HTTP contract lives, plus the writer for ledger/inbox.log, the line
# the drain leaves behind each event. See
# docs/specs/linear-inbox-wiring-design.md and
# docs/specs/2026-09-07-linear-conversation-design.md §5, §7.
#
# Exit codes are the interface, because a watcher's exit code is all its caller
# sees:
#
#   0    ok; for watch, there is work to drain
#   124  watch only: the window elapsed with nothing pending
#   4    watch only: transient - the Worker was unreachable for the whole
#        consecutive-failure ceiling. Re-arm, and say so once.
#   3    not configured, or this inbox serves another instance
#   1    hard error - 401/403, or a usable answer that says stop
#   2    usage
set -uo pipefail
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../lib/shepherd-common.sh"

ENV_FILE="${SHEPHERD_INBOX_ENV:-$HOME/.config/shepherd/inbox.env}"
INBOX_LOG="$SHEPHERD_ROOT/ledger/inbox.log"
POLL_SECONDS="${SHEPHERD_INBOX_POLL:-60}"
HEARTBEAT_EVERY=5          # polls, so ~5 minutes at the default interval
# The ceiling on consecutive unusable polls. Overridable so the tests can reach
# it in seconds instead of ten real minutes; nothing else has a reason to set it.
MAX_CONSECUTIVE_FAILURES="${SHEPHERD_INBOX_MAX_FAILURES:-10}"

usage() {
  cat >&2 <<'EOF'
shepherd-inbox owner                 is this instance the one this inbox serves?
shepherd-inbox operators             /health's operator_ids, one per line; an empty or
                               absent list prints nothing and exits 0
shepherd-inbox pending               the pending event count, on stdout
shepherd-inbox list                  the pending events, as the Worker's JSON - each
                               event's author included when the Worker sends one
shepherd-inbox ack      <event-id>
shepherd-inbox activity <session-id> <thought|elicitation|response|error> [--] <body> [--ephemeral] [--select "label=value|label=value..."]
                               --ephemeral: the next activity replaces it
                               --select: an elicitation's options (signal select); usage on any other type
                               options are read anywhere after the verb; `--` ends them, so a body
                               that itself starts with -- goes after a `--`
shepherd-inbox action   <session-id> <action> <parameter> [<result>]
                               an action activity, e.g. a DoD run: {type action, action, parameter, result}
shepherd-inbox urls     <session-id> <label>=<url>...
                               external URLs on the session (Branch, PR, Preview); they accumulate
shepherd-inbox log      <drain-start> <event-id> <session|none> <kind> <intent> <operator|member|unknown> <outcome> <received-at> [<first-word-at>]
shepherd-inbox log      answered <event-id> [<answer-at>]
                               one ledger/inbox.log line, printed back. outcome is one of
                               answered asked carded:T-NNNN routed:T-NNNN held:T-NNNN refused ignored;
                               a timestamp is ISO-8601, epoch seconds/milliseconds or the word now,
                               and lands as ISO; the last one defaults to now. Needs no Worker.
shepherd-inbox heartbeat
shepherd-inbox watch    <seconds>    the background watcher

Exit: 0 ok (watch: there is work) / 124 watch window elapsed / 4 watch: the
Worker was unreachable for the whole ceiling / 3 not configured or this inbox
serves another instance / 1 hard error / 2 usage.
EOF
  exit 2
}

# cfg_value <key> — reads KEY=value out of the env file without executing it.
# Sourcing an operator-owned file to get two strings would run anything else in
# it; there is no reason to hand that power to a config file.
cfg_value() {
  sed -n "s/^[[:space:]]*$1=//p" "$ENV_FILE" 2>/dev/null \
    | tail -n1 | sed -e 's/^["'"'"']//' -e 's/["'"'"']$//'
}

# load_config — sets INBOX_URL and INBOX_TOKEN, and on any refusal CONFIG_ERROR,
# the line the caller prints. CONFIG_ERROR never carries the token value.
load_config() {
  CONFIG_ERROR="no usable config at $ENV_FILE (need INBOX_URL and INBOX_TOKEN)"
  [ -f "$ENV_FILE" ] || return 3
  INBOX_URL=$(cfg_value INBOX_URL)
  INBOX_TOKEN=$(cfg_value INBOX_TOKEN)
  case $INBOX_URL in http://*|https://*) ;; *) return 3 ;; esac
  [ -n "$INBOX_TOKEN" ] || return 3
  # The token is interpolated into a curl -K line — header = "Authorization:
  # Bearer <token>" — where a double quote, a backslash or a newline ends the
  # value early and lets the remainder become a second header. A real Worker
  # token is URL-safe and carries none of those, so this costs an honest config
  # nothing and closes the injection. The message names the constraint; the
  # value stays out of it.
  case $INBOX_TOKEN in
    *'"'*|*'\'*|*[[:space:]]*)
      CONFIG_ERROR="INBOX_TOKEN in $ENV_FILE holds a double quote, a backslash or whitespace; a Worker token carries none of those. Fix the file — the value is not printed."
      return 3 ;;
  esac
  INBOX_URL=${INBOX_URL%/}
  return 0
}

# api <method> <path> [json-body] — sets BODY and HTTP_CODE. 0 on 2xx.
# The token goes in a header, never on the command line: an -H argument lands
# in curl's own argv, readable at /proc/<curl-pid>/cmdline for the life of the
# request. A -K config file read from stdin has no such exposure, so the
# Authorization header travels that way instead — every other option (method,
# writeout format, timeout, body) stays a normal argument since none of it is
# secret. -K - is the only stdin reader in this function (the body, when
# present, is a literal -d argument, never "-"), and curl is the last stage of
# the pipe, so pipefail still surfaces curl's exit status here, not printf's.
api() {
  local method=$1 path=$2 data=${3:-} raw
  local -a args=(-sS -X "$method" -K - -w '\n%{http_code}' --max-time 20)
  [ -n "$data" ] && args+=(-H 'Content-Type: application/json' -d "$data")
  raw=$(printf 'header = "Authorization: Bearer %s"\n' "$INBOX_TOKEN" \
          | curl "${args[@]}" "$INBOX_URL$path" 2>/dev/null) || { HTTP_CODE=000; BODY=; return 1; }
  HTTP_CODE=${raw##*$'\n'}
  BODY=${raw%$'\n'*}
  case $HTTP_CODE in 2*) return 0 ;; *) return 1 ;; esac
}

json_field() { printf '%s' "$1" | python3 -c '
import json, sys
try: d = json.load(sys.stdin)
except Exception: sys.exit(1)
v = d.get(sys.argv[1])
sys.stdout.write("" if v is None else str(v))
' "$2"; }

# pending_probe — sets PENDING, and (via api()) HTTP_CODE, in the CURRENT
# shell. cmd_watch must read HTTP_CODE after a failed poll to tell a 401 from
# a transient error; `n=$(cmd_pending)` would run cmd_pending in a command
# substitution subshell, where api()'s `HTTP_CODE=...` assignment dies with
# the subshell and never reaches the caller — HTTP_CODE would read back
# "000" forever, out there. pending_probe exists solely so nothing ever
# captures cmd_pending's stdout again.
pending_probe() {
  api GET /inbox/pending || return 1
  # A 2xx carrying a body that is not the JSON we asked for fails here too. It
  # has to: PENDING would be empty, the loop would read "nothing pending" and
  # spin out its whole window against a Worker that is answering nonsense. It
  # feeds the same consecutive-failure counter as an unreachable Worker, and
  # that counter's ceiling is exit 4 — transient, re-armed — not a disarm.
  PENDING=$(json_field "$BODY" pending) || return 1
  # A pending count is a non-negative integer or it is not an answer, and the
  # type matters as much as the presence: {"pending":"many"}, {"pending":true}
  # and {"pending":-1} all arrive here as a non-empty string, so a probe that
  # only asked "is it empty?" passed them on, failed no poll, counted no
  # failure and polled the whole window away in silence. Everything that is not
  # a run of digits is a failed poll, on the one road to the ceiling and exit 4.
  case $PENDING in ''|*[!0-9]*) PENDING=; return 1 ;; esac
  return 0
}

cmd_pending() {
  pending_probe || return 1
  printf '%s' "$PENDING"
}

cmd_list() { api GET /inbox || return 1; printf '%s\n' "$BODY"; }

cmd_ack() {
  [ $# -eq 1 ] || usage
  api POST "/inbox/$1/ack" || return 1
  printf '%s\n' "$BODY"
}

# activity <session-id> <type> <body> [--ephemeral] [--select "label=value|..."]
# Options are read anywhere after the verb; `--` ends them. --ephemeral marks
# the activity as replaced by the next one (a "reader is on it" thought).
# --select carries an elicitation's options: Linear's select signal "presents
# a list of options for the user to choose from as part of an elicitation
# activity" (linear.app/developers/agent-signals, read 2026-09-07), so on any
# other type it is usage here rather than a 400 from Linear later. An action
# is the Worker's other shape and has its own verb.
cmd_activity() {
  local session type body payload ephemeral= select= select_given= pos=()
  while [ $# -gt 0 ]; do
    case $1 in
      --ephemeral) ephemeral=1; shift ;;
      --select)    [ $# -ge 2 ] || usage; select=$2; select_given=1; shift 2 ;;
      --select=*)  select=${1#--select=}; select_given=1; shift ;;
      --)          shift; pos+=("$@"); break ;;
      --*)         echo "inbox: unknown option '$1'" >&2; return 2 ;;
      *)           pos+=("$1"); shift ;;
    esac
  done
  [ ${#pos[@]} -eq 3 ] || usage
  session=${pos[0]} type=${pos[1]} body=${pos[2]}
  case $type in
    thought|elicitation|response|error) ;;
    action) echo "inbox: an action is its own verb - shepherd-inbox action <session-id> <action> <parameter> [<result>]" >&2; return 2 ;;
    *) echo "inbox: unknown activity type '$type'" >&2; return 2 ;;
  esac
  if [ -n "$select_given" ] && [ "$type" != elicitation ]; then
    echo "inbox: --select is an elicitation's option list, not a $type's" >&2; return 2
  fi
  # python3 builds the JSON so a body carrying quotes, newlines or backslashes
  # cannot break the request or smuggle a field. The option list is parsed
  # there too: `|` between options, the FIRST `=` between label and value, so
  # a value that is a URL keeps its own query string.
  payload=$(python3 - "$type" "$body" "$ephemeral" "$select_given" "$select" <<'PY'
import json, sys
kind, body, ephemeral, select_given, select = sys.argv[1:6]
p = {"type": kind, "body": body}
if ephemeral:
    p["ephemeral"] = True
if select_given:
    options = []
    for item in select.split("|"):
        label, eq, value = item.partition("=")
        if not eq or not label.strip() or not value.strip():
            sys.exit(2)
        options.append({"label": label.strip(), "value": value.strip()})
    p["signal"] = "select"
    p["signalMetadata"] = {"options": options}
print(json.dumps(p))
PY
  ) || { echo "inbox: --select takes label=value pairs joined by |, none empty" >&2; return 2; }
  api POST "/sessions/$session/activity" "$payload" || return 1
  printf '%s\n' "$BODY"
}

# action <session-id> <action> <parameter> [<result>] — the Worker's action
# shape (its sessions.ts buildContent, read 2026-09-07: action and parameter
# required strings, result optional). A DoD run reaches the thread as one:
# action "bash tests/run.sh", parameter the branch, result the verdict.
# result is sent only when given; an omitted key is not an empty string.
cmd_action() {
  [ $# -eq 3 ] || [ $# -eq 4 ] || usage
  local session=$1 payload
  payload=$(python3 -c 'import json, sys
p = {"type": "action", "action": sys.argv[1], "parameter": sys.argv[2]}
if len(sys.argv) > 3:
    p["result"] = sys.argv[3]
print(json.dumps(p))' "$2" "$3" "${@:4}")
  api POST "/sessions/$session/activity" "$payload" || return 1
  printf '%s\n' "$BODY"
}

# urls <session-id> <label>=<url>... — POST /sessions/:id/external-url with
# {urls: [{label, url}]}. The Worker appends (addedExternalUrls after T-0236),
# so Branch, then PR, then Preview accumulate across a build. Every pair is
# checked before anything is sent: one bad pair refuses the whole call.
cmd_urls() {
  [ $# -ge 2 ] || usage
  local session=$1 payload pair; shift
  for pair in "$@"; do
    case $pair in
      *[[:space:]]*) ;;
      *=*) [ -n "${pair%%=*}" ] && [ -n "${pair#*=}" ] && continue ;;
    esac
    echo "inbox: urls takes label=url pairs, got '$pair'" >&2; return 2
  done
  payload=$(python3 -c 'import json, sys
urls = []
for item in sys.argv[1:]:
    label, _, url = item.partition("=")
    urls.append({"label": label, "url": url})
print(json.dumps({"urls": urls}))' "$@")
  api POST "/sessions/$session/external-url" "$payload" || return 1
  printf '%s\n' "$BODY"
}

cmd_heartbeat() {
  local payload='{}'
  [ -n "${SHEPHERD_ID:-}" ] && payload=$(python3 -c 'import json,sys; print(json.dumps({"shepherd_id":sys.argv[1]}))' "$SHEPHERD_ID")
  api POST /heartbeat "$payload" || return 1
  printf '%s\n' "$BODY"
}

# health_fetch — sets HEALTH_BODY from the unauthenticated /health. 1 when the
# Worker is unreachable or answers outside 2xx. No token travels: /health is
# the one route that authenticates nothing.
health_fetch() {
  local raw code
  raw=$(curl -sS -w '\n%{http_code}' --max-time 20 "$INBOX_URL/health" 2>/dev/null) || return 1
  code=${raw##*$'\n'}
  case $code in 2*) ;; *) return 1 ;; esac
  HEALTH_BODY=${raw%$'\n'*}
  return 0
}

# owner — /health reports the single shepherd id this Worker serves. Asking
# the Worker means ownership needs no second config key, and it is the seam a
# future multi-instance partition changes.
cmd_owner() {
  local got
  health_fetch || return 1
  got=$(json_field "$HEALTH_BODY" shepherd_id)
  [ -n "$got" ] || return 1
  [ "$got" = "${SHEPHERD_ID:-}" ] && return 0
  echo "inbox: this inbox serves $got, not ${SHEPHERD_ID:-<unset>}" >&2
  return 3
}

# operators — /health's operator_ids: the Linear user ids the Worker stamps
# `author.operator` from (spec 2026-09-07 §4), one per line. An empty list and
# a Worker that predates the field both print nothing and exit 0: both are the
# old world, where every author reads operator false, and a caller looping over
# stdout sees the same thing either way. A read, not a gate: it reports another
# instance's Worker too. 1 when /health is unreachable or unusable.
cmd_operators() {
  health_fetch || return 1
  printf '%s' "$HEALTH_BODY" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)
ids = d.get("operator_ids") if isinstance(d, dict) else None
if ids is None:
    sys.exit(0)
if not isinstance(ids, list):
    sys.exit(1)
for i in ids:
    if isinstance(i, str) and i.strip():
        print(i.strip())
'
}

# log — one ledger/inbox.log line (spec 2026-09-07 §7), printed back so the
# caller can quote it. Two shapes:
#   <drain-start> <event-id> <session|none> <kind> <intent> <operator|member|unknown> <outcome> <received-at> <first-word-at>
#   answered <event-id> <answer-at>
# The drain writes the first after an event's first word posts; retro appends
# the second when a carded event's response posts, so the file stays
# append-only; shepherd-metrics's inbox measure reads both. Positional in
# the line's own order so the call IS the line, and validated so the parser
# never meets a shifted column: no whitespace and nothing empty inside a
# column, outcome and trust from their vocabularies, every timestamp ISO-8601
# or epoch (seconds, or the milliseconds GET /inbox serves as received_at)
# and written as ISO on this machine's clock. The last timestamp defaults to
# now. Needs no Worker and no config. Committed through shepherd-commit by
# the drain, unlike the gitignored events.log.
LOG_OUTCOME='^(answered|asked|carded:T-[0-9]{4}|routed:T-[0-9]{4}|held:T-[0-9]{4}|refused|ignored)$'

log_column() {  # <name> <value> — a column is a non-empty run of non-blanks
  case $2 in
    ''|*[[:space:]]*) echo "inbox: log: $1 must be one non-empty word, got '$2'" >&2; return 2 ;;
  esac
}

log_ts() {  # <name> <value|now> — prints the ISO form, or 2 with a line on stderr
  local v=$2
  [ "$v" = now ] && v=$(now_iso)
  log_column "$1" "$v" || return 2
  python3 - "$v" <<'PY' || { echo "inbox: log: $1 must be ISO-8601 or epoch seconds/milliseconds, got '$2'" >&2; return 2; }
import re, sys
from datetime import datetime, timezone
v = sys.argv[1]
if re.fullmatch(r"[0-9]+", v):
    n = int(v)
    if n > 10 ** 11:          # milliseconds: Date.now() in the Worker
        n = n / 1000
    d = datetime.fromtimestamp(n, timezone.utc)
else:
    s = v[:-1] + "+00:00" if v.endswith("Z") else v
    try:
        d = datetime.fromisoformat(s)
    except ValueError:
        sys.exit(1)
if d.tzinfo is None:
    d = d.astimezone()
print(d.astimezone().isoformat(timespec="seconds"))
PY
}

cmd_log() {
  local line
  if [ "${1:-}" = answered ]; then
    [ $# -eq 2 ] || [ $# -eq 3 ] || usage
    local event=$2 at
    log_column event-id "$event" || return 2
    at=$(log_ts answer-at "${3:-now}") || return 2
    line="answered $event $at"
  else
    [ $# -eq 8 ] || [ $# -eq 9 ] || usage
    local start event session kind intent trust outcome received first
    start=$(log_ts drain-start "$1") || return 2
    log_column event-id "$2" || return 2;   event=$2
    log_column session "$3" || return 2;    session=$3
    log_column kind "$4" || return 2;       kind=$4
    log_column intent "$5" || return 2;     intent=$5
    case $6 in operator|member|unknown) trust=$6 ;;
      *) echo "inbox: log: trust must be operator, member or unknown, got '$6'" >&2; return 2 ;; esac
    if [[ $7 =~ $LOG_OUTCOME ]]; then outcome=$7; else
      echo "inbox: log: outcome must be answered, asked, carded:T-NNNN, routed:T-NNNN, held:T-NNNN, refused or ignored, got '$7'" >&2; return 2
    fi
    received=$(log_ts received-at "$8") || return 2
    first=$(log_ts first-word-at "${9:-now}") || return 2
    line="$start $event $session $kind $intent $trust $outcome $received $first"
  fi
  mkdir -p "$(dirname "$INBOX_LOG")" && printf '%s\n' "$line" >>"$INBOX_LOG" \
    || { echo "inbox: log: cannot write $INBOX_LOG" >&2; return 1; }
  printf '%s\n' "$line"
}

# still_ours — the in-loop ownership gate. Only a definite answer stops the
# watcher: cmd_owner's exit 3 means the Worker named a different instance. An
# unreachable /health cannot disprove ownership, so it is left to the
# consecutive-failure ceiling instead of being read as a verdict.
still_ours() { cmd_owner >/dev/null; [ $? -ne 3 ]; }

# watch <seconds> — the background watcher wake and monitor arm (adapter R5
# shape: a bare command, never piped, whose exit code is the whole signal).
#
# It polls rather than subscribes because a poll costs nothing and needs no
# long-lived connection from a laptop that sleeps. It heartbeats from inside
# the loop, not from the caller, so the Worker's "last online N min ago" ack
# stays honest at five-minute resolution without waking the model at all.
#
# <seconds> is the window, and callers arm 21600 (six hours). The loop costs no
# model tokens, but each exit 124 costs one model turn whose whole handler is
# "re-arm", so a short window buys nothing: ownership is re-checked inside the
# loop on every heartbeat tick and once more before work is reported, which is
# what a caller would otherwise be re-arming to re-check.
#
# Ownership is re-checked *inside* the loop, not only before it. One box runs
# several instances sharing one inbox.env and one bearer token, and that token
# authenticates the inbox, not the instance — so a non-owner that armed while
# /health was briefly unreachable would otherwise poll the owner's inbox for
# the whole window, and both instances would drain the same event into two
# cards and two workers.
cmd_watch() {
  [ $# -eq 1 ] || usage
  local window=$1 deadline now rc polls=0 failures=0
  case $window in ''|*[!0-9]*) usage ;; esac

  # An inbox that serves another instance must arm nothing. An unreachable
  # /health is NOT that case — the box may simply be offline for a moment — so
  # it falls through to the loop, where the same check runs again on every
  # heartbeat tick and once more before any drain.
  still_ours || return 3

  deadline=$(( $(date +%s) + window ))
  while :; do
    now=$(date +%s)
    [ "$now" -ge "$deadline" ] && return 124

    # The heartbeat tick fires on the first poll and every HEARTBEAT_EVERY
    # after it. It sits ahead of the probe because the loop returns the moment
    # work is pending: a busy inbox would otherwise never post one, and the
    # Worker's "last online" text would go stale exactly when shepherd is
    # busiest. Ownership rides the same tick.
    if [ $((polls % HEARTBEAT_EVERY)) -eq 0 ]; then
      still_ours || return 3
      cmd_heartbeat >/dev/null 2>&1
    fi
    polls=$((polls + 1))

    pending_probe; rc=$?
    if [ "$rc" -eq 0 ]; then
      # rc 0 means pending_probe validated the count, so the only question
      # left here is whether it is above zero. The type check lives there and
      # only there: a second, quieter one here was how a wrong-typed count
      # reached this branch and fell out of it counting nothing.
      failures=0
      if [ "$PENDING" -gt 0 ]; then
        # Never hand a drain to a non-owner. This is the last gate before the
        # caller reads exit 0 and starts posting to Linear.
        still_ours || return 3
        return 0
      fi
    else
      # A 401 cannot fix itself, and a watcher that can only ever spin is worse
      # than no watcher at all (adapter R5).
      if [ "${HTTP_CODE:-000}" = "401" ] || [ "${HTTP_CODE:-000}" = "403" ]; then
        echo "inbox: $HTTP_CODE from $INBOX_URL/inbox/pending - check INBOX_TOKEN" >&2
        return 1
      fi
      failures=$((failures + 1))
      if [ "$failures" -ge "$MAX_CONSECUTIVE_FAILURES" ]; then
        # Transient, and it says so: exit 4. Cloudflare trouble or a laptop
        # that resumed ahead of its Wi-Fi both land here, and both are over in
        # minutes. Exit 1 would have retired Linear intake and the heartbeat
        # for the rest of the session over a blip, so the callers re-arm on 4
        # and name the Worker as unreachable while they do.
        echo "inbox: $failures consecutive failures reaching $INBOX_URL - transient, re-arm" >&2
        return 4
      fi
    fi
    sleep "$POLL_SECONDS"
  done
}

[ $# -ge 1 ] || usage
verb=$1; shift
# log touches the ledger, never the Worker, so it runs on an instance with no
# inbox config at all - and never exits 3 for the lack of one.
case $verb in log) cmd_log "$@"; exit $? ;; esac
load_config; rc=$?
if [ "$rc" -ne 0 ]; then
  echo "inbox: $CONFIG_ERROR" >&2
  exit 3
fi

case $verb in
  owner)     cmd_owner ;;
  operators) cmd_operators ;;
  pending)   cmd_pending ;;
  list)      cmd_list ;;
  ack)       cmd_ack "$@" ;;
  activity)  cmd_activity "$@" ;;
  action)    cmd_action "$@" ;;
  urls)      cmd_urls "$@" ;;
  heartbeat) cmd_heartbeat ;;
  watch)     cmd_watch "$@" ;;
  *)         usage ;;
esac
